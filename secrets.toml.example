# 배포: Streamlit Cloud → Settings → Secrets 에 붙여넣기 / 로컬: .streamlit/secrets.toml
# 키가 있는 AI만 화면에 나타납니다. 최소 2개, 권장 3개(허브 + 판단 A + 판단 B)

APP_PASSWORD = "원하는-비밀번호"

# 허브 AI (Team 요금제 크레딧)
ANTHROPIC_API_KEY = "sk-ant-..."

# 판단자용 무료 API
GEMINI_API_KEY = "AIza..."          # aistudio.google.com/apikey
GROQ_API_KEY = "gsk_..."            # console.groq.com/keys
# MISTRAL_API_KEY = "..."           # console.mistral.ai (전화번호 인증, 무료 Experiment 플랜)
# OPENROUTER_API_KEY = "sk-or-..."  # openrouter.ai/keys (':free' 모델만 표시)

# 대화 기록 영구 보관 (비공개 GitHub 저장소). 없으면 앱 서버에 임시 저장되어 재시작 시 사라짐
# GITHUB_TOKEN = "github_pat_..."   # 세분화 토큰: 데이터 저장소 하나만, Contents 읽기·쓰기
# DATA_REPO = "bjt82/majority-report-data"

# 선택: 허브의 웹 검색 기본값 (화면 스위치로도 변경 가능)
WEB_SEARCH = true

# 선택: 토론 전에 모호한 점을 선택형으로 되묻기 기본값 (화면 스위치로도 변경 가능)
CLARIFY = true

# 선택: 사이드바에 표시할 Claude 월 예산 (달러)
CLAUDE_MONTHLY_BUDGET = 150

# 선택: 기본 모델 지정 (화면에서도 바꿀 수 있음)
ANTHROPIC_MODEL = "claude-sonnet-5-5"
GEMINI_MODEL = "gemini-3.8-flash"
GROQ_MODEL = "openai/gpt-oss-120b"

# 선택: 한도 초과 시 내려갈 같은 AI의 낮은 모델 (API 모델 목록에 있는 것만 사용)
# 지정하지 않으면 아래 기본값을 씁니다. 빈 목록 []이면 낮은 모델로 내려가지 않습니다.
# GEMINI_FALLBACK = "auto"                                   # 모델 목록에서 flash-lite → 다른 flash 순으로 자동 선택
# GROQ_FALLBACK = ["openai/gpt-oss-20b", "llama-3.3-70b-versatile", "qwen/qwen3-32b"]
# MISTRAL_FALLBACK = ["ministral-8b-latest"]
# ANTHROPIC_FALLBACK = ["claude-haiku-5-5"]                  # 허브 한도 초과·판단자 대타용
